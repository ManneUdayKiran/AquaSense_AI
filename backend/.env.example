# AquaSense AI Backend Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database (Leave empty or set to 'local' for zero-dependency embedded persistence)
# Optional MongoDB Atlas URI: mongodb+srv://<user>:<password>@cluster.mongodb.net/aquasense?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=aquasense_db

# Multimodal LLM Providers (Optional - high-fidelity deterministic perception engine is active by default)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=openai/gpt-oss-20b

# Knowledge Base & Upload Storage
DATA_DIR=app/data
UPLOAD_DIR=app/uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
